# Spring process settings; Compose injects DB connection and media URL from infra.env.
SPRING_PROFILES_ACTIVE=prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aiknow.kro.kr/login/oauth2/code/google
FRONTEND_ORIGIN=https://aiknow.kro.kr
LOGIN_SUCCESS_URL=https://aiknow.kro.kr/login/complete
# At least 32 non-whitespace characters. Production workflow apply provisions n8n from this value.
N8N_INGEST_TOKEN=
NEWS_BATCH_ENABLED=false
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
BATCH_SCHEMA_INIT=never
NEWS_TIME_ZONE=Asia/Seoul
NEWS_BATCH_CRON=0 * * * * *
NEWS_BATCH_PAGE_SIZE=100
NEWS_MAX_ATTEMPTS=5
NEWS_DELIVERY_LEASE=PT5M
GOOGLE_NATIVE_LOGIN_ENABLED=false
GOOGLE_NATIVE_CLIENT_IDS=
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_IDS=
APPLE_LOGIN_ENABLED=false
APPLE_CLIENT_IDS=
MEDIA_STORAGE_MODE=mounted
MEDIA_STORAGE_ENABLED=false
# Actual SMB/NFS mount visible to the Spring process (container path if containerized).
MEDIA_ROOT=/var/aiknow-media
# Planned public API origin; DNS and TLS must be ready before deployment.
MEDIA_PUBLIC_BASE_URL=https://aiknow.kro.kr/media/generated
# Create this marker only INSIDE the verified NAS mount, never in an unmounted folder.
MEDIA_VOLUME_ID=aiknow-media-prod
