# Daily news push (the server process must load this file into its environment).
NEWS_BATCH_ENABLED=false
NEWS_TIME_ZONE=Asia/Seoul
NEWS_BATCH_CRON=0 * * * * *
NEWS_BATCH_PAGE_SIZE=100
NEWS_MAX_ATTEMPTS=5
NEWS_DELIVERY_LEASE=PT5M
FCM_ENABLED=false
# Absolute path to a Firebase service-account JSON, or empty to use ADC.
FCM_CREDENTIALS_PATH=
# Initialize MySQL Batch tables once using the supplied SQL before enabling.
BATCH_SCHEMA_INIT=never
# n8n HTTP Request credential: Authorization: Bearer <this value>
# Empty disables ingestion. Generate a random secret of at least 32 characters.
N8N_INGEST_TOKEN=

# Local media storage. Start from server/ or use run-local.ps1.
# Keep existing DB/OAuth secrets; this example lists feature settings only.
SPRING_PROFILES_ACTIVE=local
MEDIA_STORAGE_MODE=local
MEDIA_STORAGE_ENABLED=true
MEDIA_ROOT=../.local/media/generated
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media/generated
# Unused in local mode. Production: see .env.prod.example.
MEDIA_VOLUME_ID=

# Native SDK ID-token login. Keep disabled until provider audiences are configured.
GOOGLE_NATIVE_LOGIN_ENABLED=false
GOOGLE_NATIVE_CLIENT_IDS=
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_IDS=
APPLE_LOGIN_ENABLED=false
APPLE_CLIENT_IDS=
