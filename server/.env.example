# Daily news push (the server process must load this file into its environment).
NEWS_BATCH_ENABLED=false
NEWS_TIME_ZONE=Asia/Seoul
NEWS_BATCH_CRON=0 * * * * *
NEWS_BATCH_PAGE_SIZE=100
NEWS_MAX_ATTEMPTS=5
NEWS_DELIVERY_LEASE=PT5M
FCM_ENABLED=false
# Absolute path to a Firebase service-account JSON, or empty to use ADC.
FCM_CREDENTIALS_PATH=
# Initialize MySQL Batch tables once using the supplied SQL before enabling.
BATCH_SCHEMA_INIT=never
