MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

N8N_PORT=5678
# Workflow deployment settings (non-secret; applied by n8n/deploy.ps1 or deploy.sh).
AIKNOW_ENV=local
AIKNOW_SERVER_BASE_URL=http://host.docker.internal:8080
AIKNOW_MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media/generated
AIKNOW_DRY_RUN=false
AIKNOW_ALLOW_IMAGE_GENERATION=true
# Prefer sourced images; at most one generated image per execution for local development.
AIKNOW_MAX_IMAGE_GENERATIONS=1
# Keep the existing encryption key when using an initialized n8n volume.
N8N_ENCRYPTION_KEY=

# All three sandbox images must use the same version.
N8N_SANDBOX_VERSION=1.6.0
# Generate three different random secrets; never commit actual values.
# n8n -> sandbox API (also used in Assistant's Sandbox API key field).
N8N_SANDBOX_API_KEY=
# Runner -> API registration.
N8N_SANDBOX_REGISTRATION_TOKEN=
# API -> runner authentication.
N8N_SANDBOX_RUNNER_KEY=

# Runtime configuration (Compose only references these values).
# Keep service DNS names aligned with the Compose services and TLS certificate names.
MYSQL_IMAGE=mysql:8.0
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_BIND_ADDRESS=127.0.0.1
SANDBOX_API_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-api:${N8N_SANDBOX_VERSION}
SANDBOX_RUNNER_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-runner-dind:${N8N_SANDBOX_VERSION}
TZ=Asia/Seoul
GENERIC_TIMEZONE=Asia/Seoul
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_API_KEY=${N8N_SANDBOX_API_KEY}
SANDBOX_API_KEYS=${N8N_SANDBOX_API_KEY}
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=${N8N_SANDBOX_REGISTRATION_TOKEN}
SANDBOX_API_RUNNER_API_KEY=${N8N_SANDBOX_RUNNER_KEY}
SANDBOX_API_GRPC_TLS_CERT_FILE=/tls/api/grpc-server.crt
SANDBOX_API_GRPC_TLS_KEY_FILE=/tls/api/grpc-server.key
SANDBOX_API_GRPC_TLS_CLIENT_CA_FILE=/tls/api/ca.crt
SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CA_FILE=/tls/api/ca.crt
SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_CERT_FILE=/tls/api/control-grpc-api-client.crt
SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_KEY_FILE=/tls/api/control-grpc-api-client.key
SANDBOX_API_RUNNER_CONTROL_GRPC_TLS_SERVER_NAME=sandbox-runner-1
SANDBOX_RUNNER_API_KEYS=${N8N_SANDBOX_RUNNER_KEY}
SANDBOX_RUNNER_REGISTRATION_TOKEN=${N8N_SANDBOX_REGISTRATION_TOKEN}
SANDBOX_RUNNER_API_GRPC_ADDR=sandbox-api:9090
SANDBOX_RUNNER_HTTP_BASE_URL=https://sandbox-runner-1:8080
SANDBOX_RUNNER_CONTROL_GRPC_LISTEN_ADDR=:9091
SANDBOX_RUNNER_CONTROL_GRPC_ADVERTISE_ADDR=sandbox-runner-1:9091
SANDBOX_RUNNER_ID=runner-1
SANDBOX_RUNNER_DOCKER_SANDBOX_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox:${N8N_SANDBOX_VERSION}
SANDBOX_RUNNER_REGISTRATION_GRPC_CA_FILE=/tls/runner/ca.crt
SANDBOX_RUNNER_REGISTRATION_GRPC_CERT_FILE=/tls/runner/grpc-client.crt
SANDBOX_RUNNER_REGISTRATION_GRPC_KEY_FILE=/tls/runner/grpc-client.key
SANDBOX_RUNNER_REGISTRATION_GRPC_SERVER_NAME=sandbox-api
SANDBOX_RUNNER_CONTROL_GRPC_TLS_CERT_FILE=/tls/runner/control-grpc-server.crt
SANDBOX_RUNNER_CONTROL_GRPC_TLS_KEY_FILE=/tls/runner/control-grpc-server.key
SANDBOX_RUNNER_CONTROL_GRPC_TLS_CLIENT_CA_FILE=/tls/runner/ca.crt
