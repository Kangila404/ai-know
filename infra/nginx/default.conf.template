server {
    listen 80;
    server_name ${API_DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }
    location / {
        return 301 https://${API_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${API_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 12m;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ~ ^/(internal/|actuator/|swagger-ui|v3/api-docs) {
        return 404;
    }
    location / {
        set $backend http://server:8080;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}

# Container-local probes; this port is never published to the host.
server {
    listen 127.0.0.1:8081;
    location = /live { return 200; }
    location = /ready { return 200; }
    location / { return 404; }
}
