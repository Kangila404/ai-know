# Complete Compose environment template. Replace example values before real deployment.
COMPOSE_PROJECT_NAME=aiknow-prod
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=aiknow
MYSQL_USER=aiknow
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_URL=jdbc:mysql://mysql:3306/aiknow?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Seoul
SERVER_IMAGE=docker.io/REPLACE_DOCKERHUB_USERNAME/aiknow-server:REPLACE_WITH_COMMIT_SHA
SERVER_ENV_FILE=/opt/aiknow/server.env
SERVER_SECRETS_PATH=/opt/aiknow/secrets
TZ=Asia/Seoul
GENERIC_TIMEZONE=Asia/Seoul
NGINX_IMAGE=nginx:stable-alpine
API_DOMAIN=api.example.invalid
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Actual regular PEM files in this directory; renew/reload procedure is in PRODUCTION.md.
TLS_CERT_PATH=/opt/aiknow/tls
MEDIA_HOST_PATH=/mnt/aiknow-media/generated
MEDIA_ROOT=/var/aiknow-media
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.42.3
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# Admin UI is reachable only through an SSH tunnel to localhost, not publicly exposed.
N8N_SECURE_COOKIE=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=720
AIKNOW_ENV=prod
# Reachable from the n8n container: replace with the real service name/private host.
AIKNOW_SERVER_BASE_URL=http://server:8080
# Must exactly match Spring MEDIA_PUBLIC_BASE_URL. Replace the example domain.
AIKNOW_MEDIA_PUBLIC_BASE_URL=https://api.example.invalid/media/generated
# Start with a collection-only check; switch explicitly after verifying NAS and credentials.
AIKNOW_DRY_RUN=true
AIKNOW_ALLOW_IMAGE_GENERATION=false
AIKNOW_MAX_IMAGE_GENERATIONS=1
